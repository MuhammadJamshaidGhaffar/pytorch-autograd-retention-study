# Bulky, regenerable diagnostics stay local, including compressed snapshots.
*.pickle
*.pickle.*
*.pkl
*.pkl.*
results/pilot_diagnostics/**/*_profiler.json
results/pilot_diagnostics/**/*_profiler.json.*
# Generated static-sensitivity source copies; generator and scan evidence are kept.
results/benchmark_sensitivity/*.py
# Removed historical archive must not be accidentally re-added.
results/legacy_*/
# Model/checkpoint artifacts are not benchmark source or measurements.
*.pt
*.pth
*.ckpt
*.safetensors

